load("@libc_constraints//:constraints.bzl", "LIBC_CONSTRAINTS")
load("@platforms//host:constraints.bzl", "HOST_CONSTRAINTS")

# Autodetected platforms describing the host machine. Both extend @platforms//host, which only
# reports the OS and CPU architecture, with constraint values detected at repository fetch time.
# Neither is registered automatically; pass one to --host_platform, --platforms or
# --extra_execution_platforms as needed.
#
# TODO: Declare @platforms//host as the parent of :generic and :generic as the parent of
# //host/private:native instead of inlining their constraints once
# https://github.com/bazelbuild/bazel/issues/31388, which makes toolchain resolution ignore
# inherited constraints, is fixed in all supported Bazel versions.
#
# :generic adds constraints that hold for every machine running the same OS and CPU architecture
# with the same system libraries (currently the Linux libc and its version). Binaries built for it
# stay as portable as those built for @platforms//host, so it is the safe choice for host tools and
# for artifacts that are distributed to other machines.
platform(
    name = "generic",
    constraint_values = HOST_CONSTRAINTS + LIBC_CONSTRAINTS,
    visibility = ["//visibility:public"],
)

# :native further adds the CPU features (and thus the x86-64 microarchitecture level) available on
# this particular machine. Toolchains that act on these constraints produce binaries that may only
# run on this machine, akin to -march=native, so only build for it when the outputs never leave the
# host.
#
# The platform itself lives in a subpackage since detecting the CPU features downloads and runs a
# prebuilt detector binary. Referring to it through an alias defers that work to the first build
# that uses :native instead of triggering it whenever this package is loaded, e.g. for :generic.
alias(
    name = "native",
    actual = "//host/private:native",
    visibility = ["//visibility:public"],
)
