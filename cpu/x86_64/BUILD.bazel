# Constraints describing the x86-64 microarchitecture level supported by a platform.
#
# Usage:
#
#   * Defining a `platform`: list individual `//cpu/x86_64/feature:<feature>_available` values or
#     append `x86_64_level_constraints("vN")` (from `x86_64.bzl`) to the `platform`'s
#     `constraint_value`s. This helper expands to the constraint value of every CPU feature included
#     in the requested level.
#
#   * Usage in `select()`: use one of the `:at_least_vN` or `//cpu/x86_64/feature:<feature>` config
#     settings as a key.
#
#   * Constraining a toolchain: list the `//cpu/x86_64/feature:<feature>_available` values it
#     requires, or `x86_64_level_constraints("vN")`, in `exec_compatible_with` /
#     `target_compatible_with`.
#
#   * Declaring the exact CPU model of a platform: set `:model` via
#     `flags = ["--@platforms_contrib//cpu/x86_64:model=<cpu>"]` (Bazel 8+). This is independent of
#     the features declared above.
#
#   * Reading the CPU model of an x86-64 target platform: add `:model` to the `toolchains` attribute
#     of a target and use the `X86_64_MODEL` Make variable.
#
# See `examples/x86_64/BUILD.bazel` for examples of these usage patterns.

load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load(":model.bzl", "x86_64_model_flag")
load(":x86_64_private.bzl", "FEATURES_UP_TO")

[
    config_setting(
        name = "at_least_{}".format(level),
        constraint_values = ["@platforms//cpu:x86_64"] + [
            "//cpu/x86_64/feature:{}_available".format(feature)
            for feature in features
        ],
        visibility = ["//visibility:public"],
    )
    for level, features in FEATURES_UP_TO.items()
]

# The CPU model of the platform as an LLVM CPU name such as "znver4", or "" if the platform isn't
# a specific CPU. //host:native sets it to the host's CPU as detected by LLVM.
#
# It doesn't imply any features: LLVM mostly maps the CPUID family and model to the name, so the
# platform may lack features of the CPU, e.g. because a VM hides them. Take them from the
# //cpu/x86_64/feature constraints instead. The value is only meaningful for x86-64 targets.
#
# Provides its value as the X86_64_MODEL Make variable. Consume it via the `toolchains` attribute
# in a BUILD file or directly from a rule implementation by reading its
# platform_common.TemplateVariableInfo provider.
x86_64_model_flag(
    name = "model",
    build_setting_default = "",
    # TODO: Use scope = "platform" once Bazel supports it, so that the model doesn't carry over to
    # other target platforms in transitions. Until then, platforms that aren't a specific CPU
    # should reset it via their flags.
    scope = "target",
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "x86_64_bzl",
    srcs = [
        "x86_64.bzl",
        "x86_64_private.bzl",
    ],
    visibility = ["//visibility:public"],
)
