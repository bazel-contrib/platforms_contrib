# Debug where options came from.
common:ci --announce_rc
# Don't rely on test logs being easily accessible from the test runner,
# though it makes the log noisier.
common:ci --test_output=errors

common --enable_platform_specific_config
# The registered example platforms claim os:linux even on a Windows machine, and unconstrained
# toolchains (e.g. the autodetected sh toolchain) would make them the default execution platform
# there, breaking tool builds such as the test launcher. Prefer the real host platform instead.
common:windows --extra_execution_platforms=@platforms//host

# The sh_tests read their data files from the runfiles tree, which Windows doesn't materialize by
# default.
startup --windows_enable_symlinks
common:windows --enable_runfiles
