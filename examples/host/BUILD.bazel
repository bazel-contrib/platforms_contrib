load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(":cfg_variants.bzl", "host_genrule")

# Writes the detected host libc versions (empty on non-Linux hosts).
host_genrule(
    name = "detect_libc",
    outs = ["output_libc.txt"],
    cmd = """echo "glibc=$(GLIBC_VERSION) musl=$(MUSL_VERSION)" > $@""",
    toolchains = [
        "@platforms_contrib//os/linux/libc/glibc:target_version",
        "@platforms_contrib//os/linux/libc/musl:target_version",
    ],
)

# Writes the host's x86-64 level; select() picks the most specialized matching level.
host_genrule(
    name = "detect_level",
    outs = ["output_level.txt"],
    cmd = "echo " + select({
        "@platforms_contrib//cpu/x86_64:at_least_v4": "x86-64-v4",
        "@platforms_contrib//cpu/x86_64:at_least_v3": "x86-64-v3",
        "@platforms_contrib//cpu/x86_64:at_least_v2": "x86-64-v2",
        "//conditions:default": "x86-64-v1",
    }) + " > $@",
)

# Exercises host detection on every OS, including where the tests below don't apply.
build_test(
    name = "host_platform_build_test",
    targets = [
        ":detect_libc",
        ":detect_level",
    ],
)

# Linux hosts are expected to have glibc or musl.
sh_test(
    name = "detect_libc_test",
    size = "small",
    srcs = ["detect_libc_test.sh"],
    args = ["$(rootpath :detect_libc)"],
    data = [":detect_libc"],
    target_compatible_with = ["@platforms//os:linux"],
)

# Expect at least x86-64-v2 on CI hosts to check detection beyond the v1 baseline.
sh_test(
    name = "detect_level_test",
    size = "small",
    srcs = ["detect_level_test.sh"],
    args = ["$(rootpath :detect_level)"],
    data = [":detect_level"],
    target_compatible_with = ["@platforms//cpu:x86_64"],
)
