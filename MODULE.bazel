module(name = "platforms_contrib")

bazel_dep(name = "bazel_features", version = "1.50.0")
bazel_dep(name = "package_metadata", version = "0.0.7")
bazel_dep(name = "platforms", version = "1.1.0")

bazel_dep(name = "rules_testing", version = "0.9.0", dev_dependency = True)

host_detection = use_extension("//private:host_detection.bzl", "host_detection")
use_repo(host_detection, "cpu_feature_constraints", "detect_cpu_linux_x86_64", "detect_cpu_osx_x86_64", "detect_cpu_windows_x86_64", "libc_constraints")

### Dependencies only used to cross-compile the prebuilt CPU feature detector (see //prebuilt).

bazel_dep(name = "bazel_lib", version = "3.2.2", dev_dependency = True)
bazel_dep(name = "cpu_features", version = "0.11.0", dev_dependency = True)
bazel_dep(name = "llvm", version = "0.8.11", dev_dependency = True)
bazel_dep(name = "rules_cc", version = "0.2.20", dev_dependency = True)

register_toolchains(
    "@llvm//toolchain:all",
    dev_dependency = True,
)
