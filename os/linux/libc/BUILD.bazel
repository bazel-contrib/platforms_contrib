# The libc flavor that toolchains should target on Linux platforms, chosen from the flavors that the
# platform makes available via the constraints in `:glibc` and `:musl` or fully statically linked.
#
# Usage:
#
#   * Choosing the flavor: set `:preference` to a ranking of options, e.g.
#     `--@platforms_contrib//os/linux/libc:preference=glibc,static-musl`.
#
#   * Following the choice in a toolchain or rule: use `:glibc_preferred`, `:musl_preferred` and
#     `:requires_fully_static` as `select()` keys, or add `:preferred` to the `toolchains` attribute
#     of a target and use the `PREFERRED_LIBC` and `PREFERRED_LIBC_REQUIRES_FULLY_STATIC` Make
#     variables.
#
# To make code depend on the libc that it's actually compiled against, use the `config_setting`s in
# `@rules_cc//cc/libc` instead.
#
# The targets that follow the preference fail for Linux platforms that don't make any of the ranked
# options available, which includes Bazel's default host platform. They are thus tagged `manual`.

load(":libc_private.bzl", "LIBC_FLAVORS", "libc_preference_flag", "preferred_libc")

# A ranking of the libc options: "glibc" and "musl" require the target platform to make the flavor
# available, while "static-glibc" and "static-musl" link the flavor fully statically and are viable
# on every Linux platform. The preferred option is the first viable one. Rankings without a viable
# option are an error.
libc_preference_flag(
    name = "preference",
    build_setting_default = [
        "glibc",
        "musl",
    ],
    # Applies to the target platform only, so that a ranking that leaves out glibc doesn't break
    # tools built for glibc-only exec platforms.
    scope = "target",
    visibility = ["//visibility:public"],
)

# Provides the preferred libc flavor of the target platform, or the empty string for non-Linux
# platforms, as the PREFERRED_LIBC Make variable and for `config_setting.flag_values`. Also provides
# "1" if it requires linking fully statically and the empty string otherwise as the
# PREFERRED_LIBC_REQUIRES_FULLY_STATIC Make variable. Consume it either via the `toolchains`
# attribute in a BUILD file or directly from a rule implementation by reading its
# platform_common.TemplateVariableInfo provider.
preferred_libc(
    name = "preferred",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

preferred_libc(
    name = "preferred_requires_fully_static",
    requires_fully_static = True,
    tags = ["manual"],
)

[
    config_setting(
        name = "{}_preferred".format(flavor),
        flag_values = {":preferred": flavor},
        tags = ["manual"],
        visibility = ["//visibility:public"],
    )
    for flavor in LIBC_FLAVORS
]

# Matches if the preferred option links fully statically. Toolchains should then link all binaries
# fully statically, e.g. by enabling the `fully_static_link` feature of a C++ toolchain, and fail
# for binaries that can't be.
config_setting(
    name = "requires_fully_static",
    flag_values = {":preferred_requires_fully_static": "true"},
    tags = ["manual"],
    visibility = ["//visibility:public"],
)
